<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="30" styleClass="products-page-bg" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.lavenderstore.CartController">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- المحتوى الرئيسي فقط بدون الـ Bar العلوي -->
    <VBox alignment="CENTER" spacing="15">
        <Label text="Your cart is feeling lonely! 🛒💔"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #5D4D7A;"/>

        <Label text="Add some aesthetic items to make it happy."
               style="-fx-font-size: 18px; -fx-text-fill: #7A6A9C;"/>
    </VBox>

    <Button fx:id="buyAndCryBtn" text="Buy &amp; Cry" onAction="#onBackToShopClick"
            style="-fx-background-color: #5D4D7A; -fx-text-fill: white; -fx-background-radius: 25; -fx-padding: 12 40; -fx-font-weight: bold; -fx-cursor: hand;"/>

</VBox>